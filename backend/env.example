# ResQNet Backend — Environment Variables

# ── API Key (optional) ────────────────────────────────────────────────────────
# Leave blank/unset to run with auth disabled (dev mode).
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"

API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Neon Postgres (optional) ──────────────────────────────────────────────────
# Leave blank to disable Postgres logging entirely — the backend will run
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

DATABASE_URL=

# ── MSG91 OTP (required for phone verification) ──────────────────────────────
# widgetId:  the hex string shown on your widget config page
# tokenAuth: your API Auth Key (Settings → API → Auth Key)

MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
