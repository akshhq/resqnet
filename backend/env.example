# ResQNet Backend — Environment Variables
# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# ── API Key (optional) ────────────────────────────────────────────────────────
# Shared secret between the backend, simulator, dashboard WebSocket, and the
# Apps Script email sender (sent as X-API-Key header on every request).
# Leave blank/unset to run with auth disabled (dev mode).
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Neon Postgres ──────────────────────────────────────────────────────────────
# Leave blank to disable Postgres logging entirely — the backend will run
# fine with in-memory state only (no persistent logs, no user accounts).
# Required for the User Dashboard.
#
# Get this from your Neon project dashboard → Connection Details.
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=

# ── Registration OTP ───────────────────────────────────────────────────────────
# Handled entirely by a separate Google Apps Script web app
# (OTP_Registration_Backend.gs) with its own Sheet and config — nothing to
# set here. The frontend (User_Dashboard/index.html) has its own
# RESQNET_WEB_APP_URL / RESQNET_SHARED_KEY config pointing at that script.

# ── Email queue (Phase 4 — emergency alerts, not live yet) ────────────────────
# Reserved for future outbound email (emergency notifications). No provider
# credentials needed here — a Google Apps Script will poll
# GET /email-queue/pending and send via GmailApp once Phase 4 lands.
# See EMAIL_QUEUE_INTEGRATION.md.
