# ResQNet Backend — Environment Variables
# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# ── API Key (optional) ────────────────────────────────────────────────────────
# Shared secret between the backend, simulator, dashboard WebSocket, and the
# Apps Script email sender (sent as X-API-Key header on every request).
# Leave blank/unset to run with auth disabled (dev mode).
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the dashboards.
CORS_ORIGINS=

# ── Neon Postgres ──────────────────────────────────────────────────────────────
# Leave blank to disable Postgres logging entirely — the backend will run
# fine with in-memory state only (no persistent logs, no user accounts).
# Required for the User Dashboard.
#
# Get this from your Neon project dashboard → Connection Details.
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=

# ── Emergency Token Emails ────────────────────────────────────────────────────
# Google Apps Script URL (Session Token.gs) that generates magic links and
# emails them to responders + the user's emergency contacts whenever an
# emergency is triggered. Called server-to-server from main.py.
# Leave blank to disable responder email notifications (the emergency itself
# will still work — location is broadcast via WebSocket as normal).
SESSION_TOKEN_WEBAPP_URL=
