# ResQNet Backend — Environment Variables
# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# ── API Key (optional) ────────────────────────────────────────────────────────
# Shared secret between the backend, simulator, dashboard WebSocket, and the
# Apps Script email sender (sent as X-API-Key header on every request).
# Leave blank/unset to run with auth disabled (dev mode).
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Neon Postgres ──────────────────────────────────────────────────────────────
# Leave blank to disable Postgres logging entirely — the backend will run
# fine with in-memory state only (no persistent logs, no user accounts,
# no email queue). Required for the User Dashboard and email verification.
#
# Get this from your Neon project dashboard → Connection Details.
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=

# ── Email delivery ─────────────────────────────────────────────────────────────
# Emails (registration/login codes, and later emergency alerts) are NOT
# sent by this backend directly. They are queued in Postgres and delivered
# by an external Google Apps Script that polls GET /email-queue/pending
# and sends via GmailApp. No email provider credentials are needed here —
# see EMAIL_QUEUE_INTEGRATION.md for the Apps Script side of this contract.

vv

# ResQNet Backend — Environment Variables

# ── API Key (optional) ────────────────────────────────────────────────────────
# Leave blank/unset to run with auth disabled (dev mode).
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"

API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Neon Postgres (optional) ──────────────────────────────────────────────────
# Leave blank to disable Postgres logging entirely — the backend will run
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

DATABASE_URL=

# ── MSG91 OTP (required for phone verification) ──────────────────────────────
# widgetId:  the hex string shown on your widget config page
# tokenAuth: your API Auth Key (Settings → API → Auth Key)

MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
